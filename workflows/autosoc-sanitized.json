    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const alert = item.json;\n  \n  const clientId = alert.tenant_name || 'isv';\n\n  // 1. Делаем глубокую копию\n  const alertDataForHash = JSON.parse(JSON.stringify(alert.body));\n\n  // 2. Удаляем ВСЕ поля, которые делают лог уникальным по времени\n  delete alertDataForHash.timestamp;\n  delete alertDataForHash.id; // Обязательно удаляем уникальный ID алерта\n  \n  // Безопасное удаление вложенных полей\n  if (alertDataForHash.predecoder) {\n    delete alertDataForHash.predecoder.timestamp;\n  }\n\n  // Поле full_log тоже содержит время в самом начале строки. \n  // Лучше всего вообще исключить его из генерации хэша, \n  // так как распарсенных полей (rule, agent, decoder и т.д.) более чем достаточно для уникальности.\n  delete alertDataForHash.full_log;\n\n  // 3. Превращаем очищенный лог в строку\n  const dataToHash = JSON.stringify(alertDataForHash);\n\n  item.json.raw_string_to_hash = dataToHash;\n  item.json.client_id = clientId;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
