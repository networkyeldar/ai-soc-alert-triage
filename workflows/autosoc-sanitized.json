        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\n// Сбрасываем старый lastId\nstaticData.lastId = undefined;\n\n// Загружаем список уже обработанных ID\nlet processedIds = staticData.processedIds || [];\n\nconst newItems = [];\n\nfor (const item of $input.all()) {\n  const currentId = item.json.alert_id;\n\n  if (!processedIds.includes(currentId)) {\n    newItems.push(item);\n    processedIds.push(currentId);\n  }\n}\n\n// Сохраняем обновлённый список\nstaticData.processedIds = processedIds;\n\nif (newItems.length === 0) {\n  return [];\n}\n\nreturn newItems;"
