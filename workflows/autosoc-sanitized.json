      "parameters": {
        "jsCode": "// Функция генерации уникального ID для Qdrant\nfunction generateUUID() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = Math.random() * 16 | 0;\n    const v = c === 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\nreturn $input.all().map((item, index) => {\n  // Обращаемся к ноде, которая достает данные из базы IRIS\n  const originalAlert = $('To get last false positive').all()[index].json;\n\n  return {\n    json: {\n      id: generateUUID(),\n      \n      // Вектор берем из текущего элемента (ответ от ноды Embeddings1 / Gemini)\n    vector:$input.first().json.data[0].embedding, \n      \n      // Формируем метаданные (Payload), которые сохранятся в базе вместе с вектором\n      payload: {\n        alert_id: originalAlert.alert_id,\n        title: originalAlert.alert_title || \"Без названия\",\n        justification: originalAlert.justification || \"Обоснование не указано\",\n        full_log: originalAlert.full_log || \"\",\n        \n        // КРИТИЧЕСКИ ВАЖНО для правильной работы маршрутизации новых алертов:\n        status: 'false_positive' \n      }\n    }\n  };\n});"
      },
